# Copy to .env and fill in. Never commit .env.

TZ=America/Denver
QUIET_START=21:00
QUIET_END=08:00

# Leave blank until the A2P 10DLC campaign is approved -- the app runs fine
# without them, using a fake gateway that logs instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------------------------------------------------------------------------
# How inbound messages reach the app. Pick one.
# ---------------------------------------------------------------------------
#
# poll    -- the app asks Twilio for new messages every POLL_SECONDS. Only
#            outbound HTTPS, so no public URL, no domain, no tunnel, no port
#            forwarding, and no webhook to secure. Best for home hosting.
#            Replies land within one poll interval instead of instantly.
#
# webhook -- Twilio POSTs to you. Instant, but needs a public HTTPS endpoint
#            and therefore a tunnel or port forwarding plus a certificate.
#
INBOUND_MODE=poll
POLL_SECONDS=20

# Only used when INBOUND_MODE=webhook.
# PUBLIC_URL must exactly match what Twilio is configured to POST to --
# signature validation hashes the URL, so a mismatch rejects every request.
PUBLIC_URL=
VALIDATE_SIGNATURE=1
